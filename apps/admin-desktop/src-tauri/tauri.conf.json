{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zeron Publisher",
  "version": "0.1.0",
  "identifier": "app.zeron.publisher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    },
    "windows": [
      {
        "title": "Zeron Publisher",
        "width": 1280,
        "height": 800,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png"],
    "targets": ["appimage"],
    "category": "Education",
    "shortDescription": "Offline-first course publisher",
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
