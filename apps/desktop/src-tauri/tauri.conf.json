{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zeron",
  "version": "0.1.0",
  "identifier": "app.zeron",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; media-src 'self' http://127.0.0.1:* https://127.0.0.1:*; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    },
    "windows": [
      {
        "title": "Zeron",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "targets": [
      "appimage"
    ],
    "category": "Education",
    "shortDescription": "Offline-first courses: learn and publish",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhEMDY5QTRCMDJCMzJFNEEKUldSS0xyTUNTNW9Halp0RjRKTnhrTlM2S3RMa0hvaU9KdU1BMTUyYUVKR3ZSOE1yZm9HakFrZ0cK",
      "endpoints": [
        "https://github.com/jehuamanna/zeron/releases/latest/download/latest.json"
      ]
    }
  }
}
